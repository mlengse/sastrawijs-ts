{
  "name": "sastrawijs-ts",
  "version": "1.0.1",
  "description": "Sastrawi is a simple javascript package which allows you to reduce inflected words in Indonesian Language (Bahasa Indonesia) to their base form (stem). Despite its simplicity, this library is designed to be high quality and well documented.",
  "main": "dist/sastrawijs-ts.cjs.js",
  "module": "dist/sastrawijs-ts.esm.mjs",
  "browser": "dist/sastrawijs-ts.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/sastrawijs-ts.cjs.js",
      "import": "./dist/sastrawijs-ts.esm.mjs",
      "browser": "./dist/sastrawijs-ts.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "run-s build test test:pkg",
    "prepare": "husky",
    "build": "rollup -c",
    "test": "jest",
    "test:pkg": "check-export-map",
    "evaluate": "npm run build && node scripts/evaluate-kbbi.js"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlengse/sastrawijs.git"
  },
  "keywords": [
    "stemmer",
    "nlp",
    "indonesia"
  ],
  "author": "mLengse (medotsys@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mlengse/sastrawijs/issues"
  },
  "homepage": "https://github.com/mlengse/sastrawijs",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-jest": "^30.5.2",
    "check-export-map": "^1.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "rollup": "^4.28.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "rootDir": "src",
    "transform": {
      "^.+\\.tsx?$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "prettier": {
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{js,ts,json,yml,yaml,md}": "prettier --write"
  }
}
